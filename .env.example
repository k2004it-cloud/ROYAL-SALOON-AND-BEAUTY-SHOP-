# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of the deployed salon app. Reset links return here.
APP_URL="https://royal-saloon-and-beauty-shop-ucxa.vercel.app"

# Password reset email delivery using your SMTP mailbox (server-only).
# Port 465 uses implicit TLS; port 587 uses STARTTLS.
SMTP_HOST="mail.codefurnace.co.ke"
SMTP_PORT="465"
SMTP_USERNAME="salon@codefurnace.co.ke"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="Royal Salon <salon@codefurnace.co.ke>"

# Optional: server-only Supabase PostgreSQL connection string.
# Set this in the backend's private environment to use Supabase instead of SQLite.
# Do not expose this value through a VITE_* variable or commit a filled-in secret.
# SALON_DATABASE_URL="postgresql://postgres:[DATABASE_PASSWORD]@[HOST]:5432/postgres?sslmode=require"
